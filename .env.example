# Copie para .env e preencha. Nunca versione o .env.
POSTGRES_USER=edurag
POSTGRES_PASSWORD=
POSTGRES_DB=edurag

LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text

# Similaridade mínima (0 a 1) para chamar o LLM; abaixo disso responde "não encontrei".
MIN_SCORE=0.5
MAX_UPLOAD_MB=20
LOG_LEVEL=INFO

# Para rodar a API fora do Docker (uvicorn local):
# DATABASE_URL=postgresql+psycopg://edurag:<senha>@localhost:5432/edurag
# OLLAMA_BASE_URL=http://localhost:11434
