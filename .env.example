# Copie para .env e preencha. Nunca versione o .env.
POSTGRES_USER=edurag
POSTGRES_PASSWORD=
POSTGRES_DB=edurag

# Quem gera as respostas: "ollama" (local, grátis) ou "claude" (API da Anthropic, pago).
# Os embeddings ficam sempre no Ollama.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
# Para usar o Claude, troque as duas linhas acima por:
#   LLM_PROVIDER=claude
#   LLM_MODEL=claude-sonnet-5      (único permitido; outro valor impede a API de subir)
# e preencha a chave do workspace "edurag" (nunca commite o .env):
ANTHROPIC_API_KEY=
# Teto de tokens de saída por resposta do Claude.
LLM_MAX_TOKENS=1024
# Esforço do Claude: low, medium, high, xhigh ou max. Mais alto = mais tokens e custo.
LLM_EFFORT=medium

EMBEDDING_MODEL=nomic-embed-text
# Prefixos do nomic-embed-text. Para modelos sem prefixo (ex.: bge-m3), deixe vazios.
EMBEDDING_DOCUMENT_PREFIX="search_document: "
EMBEDDING_QUERY_PREFIX="search_query: "

# Janela de contexto do LLM (tokens) e tempo máximo de geração (segundos).
LLM_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=300

# Similaridade mínima (0 a 1) para chamar o LLM; abaixo disso responde "não encontrei".
MIN_SCORE=0.3
MAX_UPLOAD_MB=20
LOG_LEVEL=INFO

# Para rodar a API fora do Docker (uvicorn local):
# DATABASE_URL=postgresql+psycopg://edurag:<senha>@localhost:5432/edurag
# OLLAMA_BASE_URL=http://localhost:11434
