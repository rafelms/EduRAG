# Copie para .env.local se precisar mudar algo. Nada aqui é obrigatório.

# Desenvolvimento (npm run dev): para onde o Vite repassa /api/*.
API_PROXY_TARGET=http://localhost:8000

# Build: URL base da API. Deixe vazio para usar /api (mesma origem, via nginx).
# Só defina se a API ficar em outro domínio, e então habilite CORS nela.
# VITE_API_BASE_URL=https://api.exemplo.com
